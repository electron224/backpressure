# Copy to .env.local and fill in what you use. Every key is optional:
# missing keys fall back to deterministic behavior with a clear note.
# Local Postgres for Drizzle (matches `pnpm db:up`: postgres:5432/backpressure).
DATABASE_URL=postgres://localhost:5432/backpressure
# Auth.js.
AUTH_SECRET=generate-with-openssl-rand-base64-32
GITHUB_ID=
GITHUB_SECRET=
# Coach providers (first configured wins unless COACH_PROVIDER is set).
# Anthropic (default when present).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OpenAI or any OpenAI-compatible endpoint (OpenRouter, Ollama, vLLM, Together).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Google Gemini (either variable works).
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Force one provider: anthropic | openai | google.
# COACH_PROVIDER=
